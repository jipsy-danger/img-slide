---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>IS — Image to PowerPoint</title>
  <meta name="description" content="IS converts images to PowerPoint." />
</head>

<body>
  <div class="app">
    <header class="topbar">
      <div class="brand"><span class="logo">IS</span><span>IS</span></div>
      <div class="status"><i id="statusDot"></i><span id="topStatus">READY</span></div>
    </header>

    <main>
      <section class="intro">
        <h1>Image → PowerPoint</h1>
        <p>Upload the required images, run the converter, download the PPTX.</p>
      </section>

      <section class="card">
        <div class="label">IMAGES</div>

        <div class="required-note">
          logo.png · p1g.png · p2g.png · cube.png · center.png · arrow.png · grid.png · th1.png · th2.png · ic1.png · ic2.png · ic3.png
        </div>

        <div class="dropzone" id="dropzone">
          <input id="files" type="file" accept="image/png,image/jpeg,image/webp,image/bmp,image/gif,image/tiff" multiple hidden />
          <div class="upload">+</div>
          <strong>Drop images here</strong>
          <span>or click to select</span>
          <button type="button" id="choose" class="button secondary">SELECT IMAGES</button>
        </div>

        <div class="file-head">
          <span id="count">0 / 12</span>
          <button type="button" id="clear" class="clear">CLEAR</button>
        </div>

        <div class="image-list" id="imageList">
          <div class="empty">No images selected.</div>
        </div>
      </section>

      <section class="card convert-card">
        <div class="label">CONVERT</div>

        <button type="button" class="button primary" id="convert" disabled>
          CONVERT TO POWERPOINT
        </button>

        <div class="progress">
          <div class="progress-top">
            <span id="stage">Waiting</span>
            <b id="percent">0%</b>
          </div>
          <div class="track"><div class="fill" id="fill"></div></div>
          <small id="detail">Select all required images.</small>
        </div>
      </section>

      <section class="result card">
        <div class="label">OUTPUT</div>
        <div class="result-row">
          <div>
            <strong id="resultName">No PPTX yet</strong>
            <span id="resultMeta">—</span>
          </div>
          <a id="download" class="button primary disabled" href="#" download>DOWNLOAD</a>
        </div>
      </section>
    </main>

    <footer>IS · Image to PowerPoint</footer>
  </div>

  <script>
    const filesInput = document.getElementById("files");
    const choose = document.getElementById("choose");
    const dropzone = document.getElementById("dropzone");
    const imageList = document.getElementById("imageList");
    const count = document.getElementById("count");
    const clear = document.getElementById("clear");
    const convert = document.getElementById("convert");
    const fill = document.getElementById("fill");
    const percent = document.getElementById("percent");
    const stage = document.getElementById("stage");
    const detail = document.getElementById("detail");
    const topStatus = document.getElementById("topStatus");
    const resultName = document.getElementById("resultName");
    const resultMeta = document.getElementById("resultMeta");
    const download = document.getElementById("download");
    const pipes = [...document.querySelectorAll(".pipe")];

    const REQUIRED = [
      "logo.png", "p1g.png", "p2g.png", "cube.png", "center.png",
      "arrow.png", "grid.png", "th1.png", "th2.png", "ic1.png", "ic2.png", "ic3.png"
    ];

    const selected = [];
    let worker = null;
    let downloadUrl = null;
    let running = false;

    const pipeForProgress = (value) => {
      if (value < 10) return "input";
      if (value < 66) return "runtime";
      if (value < 91) return "convert";
      return "output";
    };

    function refreshPipeline(value) {
      const current = pipeForProgress(value);
      const order = ["input", "runtime", "convert", "output"];
      const currentIndex = order.indexOf(current);
      pipes.forEach((node) => {
        const index = order.indexOf(node.dataset.pipe);
        node.classList.toggle("active", node.dataset.pipe === current);
        node.classList.toggle("done", index < currentIndex || value === 100);
      });
    }

    function setProgress(value, title, description) {
      fill.style.width = value + "%";
      percent.textContent = value + "%";
      stage.textContent = title;
      detail.textContent = description || "";
      refreshPipeline(value);
    }

    function readyCount() {
      return REQUIRED.filter((name) =>
        selected.some((file) => file.name.toLowerCase() === name.toLowerCase())
      ).length;
    }

    function render() {
      const ready = readyCount();
      count.textContent = ready + " / " + REQUIRED.length + " ASSETS";
      convert.disabled = ready !== REQUIRED.length || running;

      if (!selected.length) {
        imageList.innerHTML = '<div class="empty">Your uploaded images will appear here.</div>';
        return;
      }

      imageList.innerHTML = "";
      selected.forEach((file, index) => {
        const row = document.createElement("div");
        row.className = "image-row";

        const thumb = document.createElement("img");
        thumb.src = URL.createObjectURL(file);
        thumb.alt = file.name;

        const indexBox = document.createElement("span");
        indexBox.className = "image-index";
        indexBox.textContent = String(index + 1).padStart(2, "0");

        const info = document.createElement("div");
        info.className = "image-info";
        info.innerHTML =
          "<b>" + escapeHtml(file.name) + "</b>" +
          "<small>" + formatBytes(file.size) + " · " + file.type + "</small>";

        const remove = document.createElement("button");
        remove.className = "remove";
        remove.type = "button";
        remove.textContent = "×";
        remove.title = "Remove image";
        remove.addEventListener("click", () => {
          selected.splice(index, 1);
          render();
        });

        row.append(indexBox, thumb, info, remove);
        imageList.appendChild(row);
      });
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, (char) => ({
        "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#039;"
      }[char]));
    }

    function formatBytes(bytes) {
      if (!bytes) return "0 B";
      const units = ["B", "KB", "MB", "GB"];
      const i = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
      return (bytes / Math.pow(1024, i)).toFixed(i ? 1 : 0) + " " + units[i];
    }

    function addFiles(list) {
      for (const file of Array.from(list || [])) {
        if (!file.type.startsWith("image/")) continue;

        const index = selected.findIndex((item) =>
          item.name.toLowerCase() === file.name.toLowerCase()
        );
        if (index >= 0) selected.splice(index, 1);

        selected.push(file);
      }

      const ready = readyCount();
      render();
      topStatus.textContent =
        ready === REQUIRED.length ? "READY TO RUN PYTHON" :
        (selected.length ? "WAITING FOR REQUIRED ASSETS" : "CONVERTER READY");
    }

    choose.addEventListener("click", () => filesInput.click());
    dropzone.addEventListener("click", (event) => {
      if (!event.target.closest("button")) filesInput.click();
    });
    filesInput.addEventListener("change", () => {
      addFiles(filesInput.files);
      filesInput.value = "";
    });

    ["dragenter", "dragover"].forEach((name) => {
      dropzone.addEventListener(name, (event) => {
        event.preventDefault();
        dropzone.classList.add("drag");
      });
    });
    ["dragleave", "drop"].forEach((name) => {
      dropzone.addEventListener(name, (event) => {
        event.preventDefault();
        dropzone.classList.remove("drag");
      });
    });
    dropzone.addEventListener("drop", (event) => addFiles(event.dataTransfer.files));

    clear.addEventListener("click", () => {
      if (running) return;
      selected.length = 0;
      if (downloadUrl) {
        URL.revokeObjectURL(downloadUrl);
        downloadUrl = null;
      }
      download.href = "#";
      download.classList.add("disabled");
      resultName.textContent = "No file generated yet";
      resultMeta.textContent = "Your converted presentation will appear here when the build finishes.";
      setProgress(0, "Waiting for images", "The converter will start when you press Convert to PowerPoint.");
      topStatus.textContent = "CONVERTER READY";
      render();
    });

    function logProgress(data) {
      const value = Number(data.percent || 0);
      setProgress(value, data.stage || "Working", data.detail || "");
    }

    async function runConversion() {
      if (running) return;

      const missing = REQUIRED.filter((name) =>
        !selected.some((file) => file.name.toLowerCase() === name.toLowerCase())
      );

      if (missing.length) {
        topStatus.textContent = "MISSING REQUIRED ASSETS";
        stage.textContent = "Waiting for required assets";
        detail.textContent = missing.join(", ");
        return;
      }

      running = true;
      convert.disabled = true;
      topStatus.textContent = "CONVERSION RUNNING";
      convert.classList.add("working");

      if (downloadUrl) {
        URL.revokeObjectURL(downloadUrl);
        downloadUrl = null;
      }
      download.href = "#";
      download.classList.add("disabled");
      resultName.textContent = "Building presentation…";
      resultMeta.textContent = "IS is running build_slide.py in the browser.";

      worker?.terminate();
      worker = new Worker("/img-slide/python-worker.js?rev=20260930-3");

      worker.onmessage = (event) => {
        const data = event.data || {};

        if (data.type === "progress") {
          logProgress(data);
          return;
        }

        if (data.type === "done") {
          running = false;
          convert.disabled = false;
          convert.classList.remove("working");
          topStatus.textContent = "CONVERSION COMPLETE";

          const blob = new Blob([data.buffer], {
            type: data.mime || "application/vnd.openxmlformats-officedocument.presentationml.presentation"
          });
          downloadUrl = URL.createObjectURL(blob);

          download.href = downloadUrl;
          download.download = data.name || "IS_Images_to_PowerPoint.pptx";
          download.classList.remove("disabled");

          resultName.textContent = data.name || "IS_Images_to_PowerPoint.pptx";
          resultMeta.textContent =
            "Generated by the unchanged build_slide.py" +
            " · " + formatBytes(blob.size);

          setProgress(100, "Conversion complete", "Your PowerPoint is ready to download.");
          worker.terminate();
          worker = null;
          return;
        }

        if (data.type === "error") {
          running = false;
          convert.disabled = false;
          convert.classList.remove("working");
          topStatus.textContent = "CONVERSION ERROR";
          stage.textContent = "Build failed";
          detail.textContent = data.message || "The Python converter returned an error.";

          if (data.detail) {
            console.error(data.detail);
          }

          worker.terminate();
          worker = null;
        }
      };

      const payload = [];
      const transfer = [];

      for (const file of selected) {
        const buffer = await file.arrayBuffer();
        payload.push({ name: file.name, buffer });
        transfer.push(buffer);
      }

      setProgress(3, "Preparing input", "Sending selected images to the browser Python worker…");
      worker.postMessage({ type: "build", files: payload }, transfer);
    }

    convert.addEventListener("click", runConversion);

    const clock = document.getElementById("clock");
    function tick() {
      clock.textContent = new Date().toLocaleTimeString([], { hour12: false });
    }
    tick();
    setInterval(tick, 1000);

    render();
  </script>
</body>
</html>

<style>
:global(*){box-sizing:border-box}
:global(body){
  margin:0;
  min-height:100vh;
  background:#070a0f;
  color:#edf2f7;
  font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
}
:global(button),:global(input){font:inherit}
:global(a){color:inherit;text-decoration:none}

.app{width:min(900px,calc(100% - 28px));margin:0 auto;padding:16px 0 28px}
.topbar{
  height:50px;padding:0 13px;border:1px solid #1d2733;border-radius:10px;
  background:#0b1016;display:flex;align-items:center;justify-content:space-between;
}
.brand{display:flex;align-items:center;gap:9px;font-weight:900;letter-spacing:.1em;font-size:12px}
.logo{
  width:28px;height:28px;border-radius:7px;background:#2b8cff;
  display:grid;place-items:center;color:#fff;font-size:10px;
}
.status{display:flex;align-items:center;gap:7px;color:#7f8b99;font-size:8px;font-weight:900;letter-spacing:.1em}
.status i{width:6px;height:6px;border-radius:50%;background:#43dd95}

.intro{padding:48px 2px 24px}
.intro h1{margin:0;font-size:42px;letter-spacing:-.055em;line-height:1}
.intro p{margin:9px 0 0;color:#7f8b99;font-size:13px}

.card{
  border:1px solid #1d2733;border-radius:11px;background:#0b1016;
  padding:15px;margin-top:10px;
}
.label{
  color:#718092;font-size:8px;font-weight:900;letter-spacing:.14em;margin-bottom:10px
}
.required-note{
  padding:8px 10px;margin-bottom:9px;border:1px solid #182330;border-radius:8px;
  color:#647384;background:#090e14;font-size:8px;line-height:1.5
}
.dropzone{
  min-height:160px;border:1px dashed #304153;border-radius:9px;
  background:#090e14;display:flex;flex-direction:column;align-items:center;justify-content:center;
  cursor:pointer;text-align:center;transition:.15s;
}
.dropzone:hover,.dropzone.drag{border-color:#2b8cff;background:#0b121a}
.upload{
  width:38px;height:38px;border:1px solid #2b4055;border-radius:8px;
  display:grid;place-items:center;color:#5aa6ff;font-size:20px;margin-bottom:8px
}
.dropzone strong{font-size:11px}
.dropzone span{color:#677587;font-size:9px;margin-top:3px}
.button{
  border:1px solid #2b4055;border-radius:8px;padding:9px 12px;
  background:#101923;color:#dfe7ef;font-size:9px;font-weight:900;letter-spacing:.06em;
  cursor:pointer;
}
.button.secondary{margin-top:11px}
.button.primary{background:#2b8cff;border-color:#2b8cff;color:#fff}
.button.primary:hover:not(:disabled){background:#2179dc}
.button:disabled,.button.disabled{opacity:.35;pointer-events:none;cursor:not-allowed}

.file-head{display:flex;justify-content:space-between;align-items:center;margin:13px 1px 7px;color:#7e8b99;font-size:8px;font-weight:900}
.clear{border:0;background:transparent;color:#687688;font-size:8px;font-weight:900;cursor:pointer}
.clear:hover{color:#ff7a86}
.image-list{display:grid;gap:5px}
.empty{
  border:1px solid #182330;border-radius:8px;padding:12px;text-align:center;
  color:#5f6c7c;font-size:9px
}
.image-row{
  display:grid;grid-template-columns:27px 55px 1fr 25px;gap:9px;align-items:center;
  padding:6px;border:1px solid #182330;border-radius:8px;background:#090e14
}
.image-index{
  width:23px;height:23px;border-radius:5px;background:#0d1a27;
  display:grid;place-items:center;color:#58a9ff;font-size:7px;font-weight:900
}
.image-row img{width:55px;height:37px;object-fit:cover;border-radius:5px;background:#070b10}
.image-info{min-width:0;display:flex;flex-direction:column}
.image-info b{font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.image-info small{font-size:7px;color:#647384;margin-top:1px}
.remove{
  width:24px;height:24px;border:1px solid #273544;border-radius:6px;
  background:#0b1219;color:#788596;cursor:pointer
}
.remove:hover{color:#ff7a86;border-color:#65343b}

.convert-card{display:grid;grid-template-columns:auto 1fr;gap:15px;align-items:end}
.convert-card .label{grid-column:1/-1;margin-bottom:0}
.progress{min-width:0}
.progress-top{display:flex;justify-content:space-between;gap:10px;color:#8b97a5;font-size:9px}
.progress-top b{color:#e8eef4}
.track{height:7px;border-radius:99px;background:#111922;margin-top:7px;overflow:hidden}
.fill{height:100%;width:0;background:#2b8cff;border-radius:99px;transition:width .2s}
.progress small{display:block;color:#647384;font-size:8px;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

.result .label{margin-bottom:8px}
.result-row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.result-row>div{min-width:0}
.result-row strong{display:block;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.result-row span{display:block;color:#647384;font-size:8px;margin-top:2px}

footer{padding:15px 2px 0;color:#566272;font-size:8px}

@media(max-width:620px){
  .app{width:min(100% - 18px,900px)}
  .intro{padding:38px 1px 19px}
  .intro h1{font-size:34px}
  .convert-card{grid-template-columns:1fr}
  .convert-card .button{width:100%}
  .result-row{align-items:stretch;flex-direction:column}
  .result-row .button{width:100%}
}
</style>