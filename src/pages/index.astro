<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>IS — Image to PowerPoint</title>
  <meta name="description" content="IS converts images into PowerPoint slides." />
</head>

<body>
  <div class="page-glow"></div>

  <div class="app">
    <header class="topbar">
      <a class="brand" href="./" aria-label="IS home">
        <span class="brand-mark">IS</span>
        <span class="brand-name">IS</span>
      </a>

      <div class="top-status">
        <span class="status-dot"></span>
        <span id="topStatus">CONVERTER READY</span>
      </div>

      <a class="github" href="https://github.com/jipsy-danger/img-slide" target="_blank" rel="noreferrer">
        SOURCE ↗
      </a>
    </header>

    <main>
      <section class="hero">
        <div class="eyebrow">IMAGE TO POWERPOINT CONVERTER</div>
        <h1>Turn images into<br /><span>PowerPoint slides.</span></h1>
        <p>
          Upload the image assets expected by the project's <strong>build_slide.py</strong>.
          IS runs that Python file unchanged and gives you the PowerPoint it generates.
        </p>
      </section>

      <section class="workspace">
        <div class="workspace-head">
          <div>
            <div class="kicker">01 / IMAGES</div>
            <h2>Load build assets</h2>
          </div>
          <div class="count" id="count">0 / 12 ASSETS</div>
        </div>

        <div class="required-note">Required by build_slide.py: logo.png · p1g.png · p2g.png · cube.png · center.png · arrow.png · grid.png · th1.png · th2.png · ic1.png · ic2.png · ic3.png</div>

        <div class="dropzone" id="dropzone">
          <input id="files" type="file" accept="image/png,image/jpeg,image/webp,image/bmp,image/gif,image/tiff" multiple hidden />
          <div class="upload-symbol">+</div>
          <h3>DROP IMAGES HERE</h3>
          <p>or click to select files</p>
          <button type="button" class="button light" id="choose">SELECT IMAGES</button>
          <div class="hint">Upload the exact asset filenames used by build_slide.py</div>
        </div>

        <div class="selected-head">
          <span>LOADED ASSETS</span>
          <button type="button" class="text-button" id="clear">CLEAR ALL</button>
        </div>
        <div class="image-list" id="imageList">
          <div class="empty">Your uploaded images will appear here.</div>
        </div>
      </section>

      <section class="convert section">
        <div class="kicker">02 / RUN</div>
        <div class="convert-grid">
          <div class="convert-info">
            <h2>Run build_slide.py</h2>
            <p>IS uses the repository Python file exactly as it is. The uploaded assets are placed beside it, then the generated PowerPoint is returned to the browser.</p>

            <div class="rules">
              <div><span>01</span><b>12 assets</b><small>required by the Python file</small></div>
              <div><span>02</span><b>Exact source</b><small>build_slide.py is unchanged</small></div>
              <div><span>03</span><b>Output</b><small>DarcARK_Innovation_Uniqueness.pptx</small></div>
            </div>

            <button type="button" class="button convert-button" id="convert" disabled>
              <span class="led"></span>
              CONVERT TO POWERPOINT
            </button>
          </div>

          <div class="progress-panel">
            <div class="panel-title">
              <span>BUILD PROGRESS</span>
              <strong id="percent">0%</strong>
            </div>

            <div class="progress-track">
              <div class="progress-fill" id="fill"></div>
            </div>

            <div class="stage" id="stage">Waiting for images</div>
            <div class="detail" id="detail">The converter will start when you press Convert to PowerPoint.</div>

            <div class="pipeline">
              <div class="pipe active" data-pipe="input"><b>INPUT</b><span>Images</span></div>
              <div class="pipe" data-pipe="runtime"><b>PYTHON</b><span>Runtime</span></div>
              <div class="pipe" data-pipe="convert"><b>BUILD</b><span>Slides</span></div>
              <div class="pipe" data-pipe="output"><b>OUTPUT</b><span>PPTX</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="output section">
        <div class="kicker">03 / RESULT</div>
        <div class="result-card" id="result">
          <div class="result-mark">PPTX</div>
          <div class="result-copy">
            <div class="result-label">POWERPOINT PRESENTATION</div>
            <h2 id="resultName">No file generated yet</h2>
            <p id="resultMeta">The PowerPoint generated by build_slide.py will appear here when the build finishes.</p>
          </div>
          <a id="download" class="button light disabled" href="#" download>DOWNLOAD PPTX</a>
        </div>
      </section>

      <section class="technical section">
        <div class="kicker">04 / ENGINE</div>
        <div class="tech-grid">
          <div class="tech-card">
            <span>SOURCE</span>
            <strong>build_slide.py</strong>
            <p>The repository Python file is executed unchanged.</p>
          </div>
          <div class="tech-card">
            <span>PYTHON RUNTIME</span>
            <strong>Pyodide</strong>
            <p>Python runs inside the browser through WebAssembly.</p>
          </div>
          <div class="tech-card">
            <span>POWERPOINT</span>
            <strong>python-pptx</strong>
            <p>The final presentation is generated as a standard .pptx file.</p>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <span>IS // IMAGE TO POWERPOINT</span>
      <span>ASTRO · PYTHON · WEBASSEMBLY · <span id="clock">--:--:--</span></span>
    </footer>
  </div>

  <script>
    const filesInput = document.getElementById("files");
    const choose = document.getElementById("choose");
    const dropzone = document.getElementById("dropzone");
    const imageList = document.getElementById("imageList");
    const count = document.getElementById("count");
    const clear = document.getElementById("clear");
    const convert = document.getElementById("convert");
    const fill = document.getElementById("fill");
    const percent = document.getElementById("percent");
    const stage = document.getElementById("stage");
    const detail = document.getElementById("detail");
    const topStatus = document.getElementById("topStatus");
    const resultName = document.getElementById("resultName");
    const resultMeta = document.getElementById("resultMeta");
    const download = document.getElementById("download");
    const pipes = [...document.querySelectorAll(".pipe")];

    const REQUIRED = [
      "logo.png", "p1g.png", "p2g.png", "cube.png", "center.png",
      "arrow.png", "grid.png", "th1.png", "th2.png", "ic1.png", "ic2.png", "ic3.png"
    ];

    const selected = [];
    let worker = null;
    let downloadUrl = null;
    let running = false;

    const pipeForProgress = (value) => {
      if (value < 10) return "input";
      if (value < 66) return "runtime";
      if (value < 91) return "convert";
      return "output";
    };

    function refreshPipeline(value) {
      const current = pipeForProgress(value);
      const order = ["input", "runtime", "convert", "output"];
      const currentIndex = order.indexOf(current);
      pipes.forEach((node) => {
        const index = order.indexOf(node.dataset.pipe);
        node.classList.toggle("active", node.dataset.pipe === current);
        node.classList.toggle("done", index < currentIndex || value === 100);
      });
    }

    function setProgress(value, title, description) {
      fill.style.width = value + "%";
      percent.textContent = value + "%";
      stage.textContent = title;
      detail.textContent = description || "";
      refreshPipeline(value);
    }

    function readyCount() {
      return REQUIRED.filter((name) =>
        selected.some((file) => file.name.toLowerCase() === name.toLowerCase())
      ).length;
    }

    function render() {
      const ready = readyCount();
      count.textContent = ready + " / " + REQUIRED.length + " ASSETS";
      convert.disabled = ready !== REQUIRED.length || running;

      if (!selected.length) {
        imageList.innerHTML = '<div class="empty">Your uploaded images will appear here.</div>';
        return;
      }

      imageList.innerHTML = "";
      selected.forEach((file, index) => {
        const row = document.createElement("div");
        row.className = "image-row";

        const thumb = document.createElement("img");
        thumb.src = URL.createObjectURL(file);
        thumb.alt = file.name;

        const indexBox = document.createElement("span");
        indexBox.className = "image-index";
        indexBox.textContent = String(index + 1).padStart(2, "0");

        const info = document.createElement("div");
        info.className = "image-info";
        info.innerHTML =
          "<b>" + escapeHtml(file.name) + "</b>" +
          "<small>" + formatBytes(file.size) + " · " + file.type + "</small>";

        const remove = document.createElement("button");
        remove.className = "remove";
        remove.type = "button";
        remove.textContent = "×";
        remove.title = "Remove image";
        remove.addEventListener("click", () => {
          selected.splice(index, 1);
          render();
        });

        row.append(indexBox, thumb, info, remove);
        imageList.appendChild(row);
      });
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, (char) => ({
        "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#039;"
      }[char]));
    }

    function formatBytes(bytes) {
      if (!bytes) return "0 B";
      const units = ["B", "KB", "MB", "GB"];
      const i = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
      return (bytes / Math.pow(1024, i)).toFixed(i ? 1 : 0) + " " + units[i];
    }

    function addFiles(list) {
      for (const file of Array.from(list || [])) {
        if (!file.type.startsWith("image/")) continue;

        const index = selected.findIndex((item) =>
          item.name.toLowerCase() === file.name.toLowerCase()
        );
        if (index >= 0) selected.splice(index, 1);

        selected.push(file);
      }

      const ready = readyCount();
      render();
      topStatus.textContent =
        ready === REQUIRED.length ? "READY TO RUN PYTHON" :
        (selected.length ? "WAITING FOR REQUIRED ASSETS" : "CONVERTER READY");
    }

    choose.addEventListener("click", () => filesInput.click());
    dropzone.addEventListener("click", (event) => {
      if (!event.target.closest("button")) filesInput.click();
    });
    filesInput.addEventListener("change", () => {
      addFiles(filesInput.files);
      filesInput.value = "";
    });

    ["dragenter", "dragover"].forEach((name) => {
      dropzone.addEventListener(name, (event) => {
        event.preventDefault();
        dropzone.classList.add("drag");
      });
    });
    ["dragleave", "drop"].forEach((name) => {
      dropzone.addEventListener(name, (event) => {
        event.preventDefault();
        dropzone.classList.remove("drag");
      });
    });
    dropzone.addEventListener("drop", (event) => addFiles(event.dataTransfer.files));

    clear.addEventListener("click", () => {
      if (running) return;
      selected.length = 0;
      if (downloadUrl) {
        URL.revokeObjectURL(downloadUrl);
        downloadUrl = null;
      }
      download.href = "#";
      download.classList.add("disabled");
      resultName.textContent = "No file generated yet";
      resultMeta.textContent = "Your converted presentation will appear here when the build finishes.";
      setProgress(0, "Waiting for images", "The converter will start when you press Convert to PowerPoint.");
      topStatus.textContent = "CONVERTER READY";
      render();
    });

    function logProgress(data) {
      const value = Number(data.percent || 0);
      setProgress(value, data.stage || "Working", data.detail || "");
    }

    async function runConversion() {
      if (running) return;

      const missing = REQUIRED.filter((name) =>
        !selected.some((file) => file.name.toLowerCase() === name.toLowerCase())
      );

      if (missing.length) {
        topStatus.textContent = "MISSING REQUIRED ASSETS";
        stage.textContent = "Waiting for required assets";
        detail.textContent = missing.join(", ");
        return;
      }

      running = true;
      convert.disabled = true;
      topStatus.textContent = "CONVERSION RUNNING";
      convert.classList.add("working");

      if (downloadUrl) {
        URL.revokeObjectURL(downloadUrl);
        downloadUrl = null;
      }
      download.href = "#";
      download.classList.add("disabled");
      resultName.textContent = "Building presentation…";
      resultMeta.textContent = "IS is running build_slide.py in the browser.";

      worker?.terminate();
      worker = new Worker("/img-slide/python-worker.js?rev=20260930-3");

      worker.onmessage = (event) => {
        const data = event.data || {};

        if (data.type === "progress") {
          logProgress(data);
          return;
        }

        if (data.type === "done") {
          running = false;
          convert.disabled = false;
          convert.classList.remove("working");
          topStatus.textContent = "CONVERSION COMPLETE";

          const blob = new Blob([data.buffer], {
            type: data.mime || "application/vnd.openxmlformats-officedocument.presentationml.presentation"
          });
          downloadUrl = URL.createObjectURL(blob);

          download.href = downloadUrl;
          download.download = data.name || "IS_Images_to_PowerPoint.pptx";
          download.classList.remove("disabled");

          resultName.textContent = data.name || "IS_Images_to_PowerPoint.pptx";
          resultMeta.textContent =
            "Generated by the unchanged build_slide.py" +
            " · " + formatBytes(blob.size);

          setProgress(100, "Conversion complete", "Your PowerPoint is ready to download.");
          worker.terminate();
          worker = null;
          return;
        }

        if (data.type === "error") {
          running = false;
          convert.disabled = false;
          convert.classList.remove("working");
          topStatus.textContent = "CONVERSION ERROR";
          stage.textContent = "Build failed";
          detail.textContent = data.message || "The Python converter returned an error.";

          if (data.detail) {
            console.error(data.detail);
          }

          worker.terminate();
          worker = null;
        }
      };

      const payload = [];
      const transfer = [];

      for (const file of selected) {
        const buffer = await file.arrayBuffer();
        payload.push({ name: file.name, buffer });
        transfer.push(buffer);
      }

      setProgress(3, "Preparing input", "Sending selected images to the browser Python worker…");
      worker.postMessage({ type: "build", files: payload }, transfer);
    }

    convert.addEventListener("click", runConversion);

    const clock = document.getElementById("clock");
    function tick() {
      clock.textContent = new Date().toLocaleTimeString([], { hour12: false });
    }
    tick();
    setInterval(tick, 1000);

    render();
  </script>
</body>
</html>

<style>
:global(*){box-sizing:border-box}
:global(html){scroll-behavior:smooth}
:global(body){
  margin:0;
  background:#06090e;
  color:#eaf1f8;
  font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
  min-height:100vh;
}
:global(button),:global(input){font:inherit}
:global(a){color:inherit;text-decoration:none}

.page-glow{
  position:fixed;inset:0;pointer-events:none;
  background:
    radial-gradient(620px 340px at 72% -5%,rgba(43,184,255,.16),transparent 70%),
    radial-gradient(540px 300px at -5% 42%,rgba(113,78,255,.10),transparent 72%);
}
.app{max-width:1180px;margin:0 auto;padding:22px 24px;position:relative}
.topbar{
  height:58px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;
  padding:0 16px;border:1px solid #1d2a39;border-radius:14px;
  background:rgba(9,15,23,.88);backdrop-filter:blur(18px);
  position:sticky;top:12px;z-index:10;box-shadow:0 18px 60px rgba(0,0,0,.35);
}
.brand{display:flex;align-items:center;gap:10px;font-weight:900;letter-spacing:.13em}
.brand-mark{
  width:32px;height:32px;border-radius:9px;display:grid;place-items:center;
  background:linear-gradient(135deg,#7d69ff,#25c7f7);font-size:11px;box-shadow:0 8px 24px rgba(56,172,255,.18);
}
.brand-name{font-size:12px}
.top-status{display:flex;align-items:center;gap:8px;color:#8c9bad;font-size:9px;font-weight:900;letter-spacing:.14em}
.status-dot{width:7px;height:7px;border-radius:50%;background:#45e49c;box-shadow:0 0 12px rgba(69,228,156,.7)}
.github{justify-self:end;color:#8694a6;font-size:9px;font-weight:900;letter-spacing:.14em}
.github:hover{color:#fff}

.hero{padding:88px 6px 54px;max-width:850px}
.eyebrow,.kicker{color:#48caff;font-size:9px;font-weight:900;letter-spacing:.22em}
.hero h1{font-size:clamp(44px,7vw,76px);line-height:.93;letter-spacing:-.065em;margin:15px 0 19px}
.hero h1 span{color:#9682ff}
.hero p{margin:0;color:#8795a8;font-size:16px;max-width:770px}
.hero p strong{color:#dde8f4}

.workspace,.progress-panel,.convert-info,.result-card,.tech-card{
  border:1px solid #1b2b3c;
  background:linear-gradient(145deg,#0c151f,#09111a);
  box-shadow:0 24px 70px rgba(0,0,0,.32);
}
.workspace{border-radius:18px;padding:22px}
.workspace-head{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:18px}
.workspace h2,.convert-info h2{font-size:24px;letter-spacing:-.04em;margin:5px 0 0}
.count{
  padding:7px 10px;border:1px solid #29445b;border-radius:999px;color:#a9dcf6;
  background:#0c1925;font-size:9px;font-weight:900;letter-spacing:.12em;
}
.required-note{
  margin:0 0 10px;padding:10px 12px;border:1px solid #17293a;border-radius:10px;
  background:#08111a;color:#66778b;font-size:8px;line-height:1.6;letter-spacing:.03em;
}
.dropzone{
  min-height:235px;border:1px dashed #2a506c;border-radius:16px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;
  cursor:pointer;padding:22px;
  background:radial-gradient(500px 180px at 50% 5%,rgba(50,193,255,.10),transparent 70%),#08111a;
  transition:.18s ease;
}
.dropzone.drag,.dropzone:hover{border-color:#53d5ff;transform:translateY(-1px);background-color:#091521}
.upload-symbol{
  width:48px;height:48px;border-radius:13px;border:1px solid #31536a;display:grid;place-items:center;
  color:#55d5ff;background:#0d1c28;font-size:25px;margin-bottom:11px;
}
.dropzone h3{font-size:12px;letter-spacing:.17em;margin:0}
.dropzone p{color:#728197;font-size:11px;margin:5px 0 14px}
.hint{margin-top:12px;color:#526276;font-size:8px;letter-spacing:.15em}
.button{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:10px;
  padding:11px 14px;border:1px solid #294054;background:#10202d;color:#dce8f3;
  font-size:10px;font-weight:900;letter-spacing:.08em;cursor:pointer;transition:.16s ease;
}
.button:hover:not(:disabled){transform:translateY(-1px);border-color:#45627a}
.button.light{background:#edf7ff;color:#07111a;border-color:#edf7ff}
.button:disabled,.button.disabled{opacity:.35;cursor:not-allowed;pointer-events:none}
.selected-head{display:flex;justify-content:space-between;align-items:center;margin:17px 1px 9px;color:#758498;font-size:8px;font-weight:900;letter-spacing:.15em}
.text-button{background:none;border:0;padding:3px;color:#647386;font-size:8px;font-weight:900;letter-spacing:.12em;cursor:pointer}
.text-button:hover{color:#ff7782}
.image-list{display:grid;gap:7px}
.empty{border:1px solid #172737;border-radius:11px;padding:14px;text-align:center;color:#5f6e81;font-size:10px}
.image-row{
  display:grid;grid-template-columns:31px 64px 1fr auto;gap:11px;align-items:center;
  padding:8px;border:1px solid #182838;border-radius:11px;background:#09121a;
}
.image-index{
  width:26px;height:26px;display:grid;place-items:center;border-radius:7px;
  background:#0d1d2a;color:#5acfff;font-size:8px;font-weight:900;
}
.image-row img{width:64px;height:44px;object-fit:cover;border-radius:7px;background:#05090d}
.image-info{display:flex;flex-direction:column;min-width:0}
.image-info b{font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.image-info small{color:#66768a;font-size:8px;margin-top:2px}
.remove{
  width:28px;height:28px;border:1px solid #2d4153;background:#0b151e;color:#7d8da0;border-radius:8px;
  cursor:pointer;font-size:16px;line-height:1;
}
.remove:hover{color:#ff7581;border-color:#713840}

.section{margin-top:55px}
.convert-grid{display:grid;grid-template-columns:1fr .94fr;gap:14px;margin-top:13px}
.convert-info,.progress-panel{border-radius:17px;padding:19px}
.convert-info p{color:#78889b;max-width:570px;margin:8px 0 18px}
.rules{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:18px 0}
.rules>div{border:1px solid #17293a;border-radius:10px;padding:10px;background:#08111a}
.rules span{display:block;color:#50cbff;font-size:8px;font-weight:900}
.rules b{display:block;margin-top:4px;font-size:9px}
.rules small{display:block;color:#69788c;font-size:8px;margin-top:2px}
.convert-button{margin-top:4px;min-width:220px;background:#edf7ff;color:#07111a;border-color:#edf7ff}
.led{width:7px;height:7px;border-radius:50%;background:#101820}
.convert-button:not(:disabled) .led{background:#45e49c;box-shadow:0 0 11px rgba(69,228,156,.6)}
.convert-button.working .led{animation:pulse .8s infinite}

.panel-title{display:flex;justify-content:space-between;align-items:center;color:#748397;font-size:8px;font-weight:900;letter-spacing:.14em}
.panel-title strong{color:#e0edf7;font-size:15px;letter-spacing:0}
.progress-track{height:9px;border-radius:999px;background:#071019;border:1px solid #172737;overflow:hidden;margin-top:14px}
.progress-fill{height:100%;width:0%;border-radius:999px;background:linear-gradient(90deg,#2cc6ff,#8f79ff,#43df9a);transition:width .22s ease}
.stage{font-size:15px;font-weight:900;margin-top:16px}
.detail{font-size:10px;color:#718095;margin-top:3px;min-height:34px}
.pipeline{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:17px}
.pipe{border:1px solid #172839;border-radius:9px;background:#09121a;padding:9px}
.pipe b{display:block;font-size:8px;letter-spacing:.08em;color:#748397}
.pipe span{display:block;color:#556579;font-size:8px;margin-top:2px}
.pipe.active{border-color:#315b77;background:#0c1924}
.pipe.active b{color:#4fd2ff}
.pipe.done{border-color:#245040}
.pipe.done b{color:#45df9c}

.result-card{
  margin-top:13px;border-radius:17px;padding:18px;display:grid;grid-template-columns:54px 1fr auto;gap:14px;align-items:center;
}
.result-mark{
  width:54px;height:54px;border-radius:13px;display:grid;place-items:center;
  background:linear-gradient(145deg,#6347d3,#2aa6d8);font-size:9px;font-weight:950;letter-spacing:.09em;
}
.result-label{color:#68798d;font-size:8px;font-weight:900;letter-spacing:.13em}
.result-card h2{font-size:16px;margin:5px 0 2px;letter-spacing:-.02em}
.result-card p{margin:0;color:#718095;font-size:9px}

