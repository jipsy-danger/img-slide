<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>IS — Image to PowerPoint</title>
</head>
<body>
  <div class="app">
    <header class="topbar">
      <div class="brand"><span class="logo">IS</span><b>IS</b></div>
      <div class="status"><i></i><span id="topStatus">READY</span></div>
    </header>

    <main>
      <section class="intro">
        <div class="eyebrow">IMAGE → POWERPOINT</div>
        <h1>Convert images to slides.</h1>
      </section>

      <section class="card">
        <div class="row-head">
          <div class="label">IMAGES</div>
          <span class="count" id="count">0</span>
        </div>

        <div class="dropzone" id="dropzone">
          <input id="files" type="file" accept="image/png,image/jpeg,image/webp,image/bmp,image/gif,image/tiff" multiple hidden />
          <div class="upload">+</div>
          <strong>Drop images here</strong>
          <button type="button" id="choose" class="button secondary">SELECT IMAGES</button>
        </div>

        <div class="files-head">
          <span>SELECTED</span>
          <button id="clear" class="clear" type="button">CLEAR</button>
        </div>

        <div class="image-list" id="imageList">
          <div class="empty">No images selected.</div>
        </div>

        <button type="button" class="button primary convert" id="convert" disabled>
          CONVERT TO POWERPOINT
        </button>
      </section>

      <section class="card progress-card">
        <div class="progress-head">
          <span id="stage">Waiting</span>
          <b id="percent">0%</b>
        </div>
        <div class="track"><div class="fill" id="fill"></div></div>
        <div class="detail" id="detail">Select one or more images.</div>
      </section>

      <section class="card result">
        <div class="label">OUTPUT</div>
        <div class="result-row">
          <div>
            <strong id="resultName">No file yet</strong>
            <span id="resultMeta">—</span>
          </div>
          <a id="download" class="button primary disabled" href="#" download>DOWNLOAD</a>
        </div>
      </section>
    </main>

    <footer>IS · Image to PowerPoint</footer>
  </div>

  <script>
    import PptxGenJS from "pptxgenjs";

    const filesInput = document.getElementById("files");
    const dropzone = document.getElementById("dropzone");
    const imageList = document.getElementById("imageList");
    const count = document.getElementById("count");
    const clear = document.getElementById("clear");
    const convert = document.getElementById("convert");
    const fill = document.getElementById("fill");
    const percent = document.getElementById("percent");
    const stage = document.getElementById("stage");
    const detail = document.getElementById("detail");
    const topStatus = document.getElementById("topStatus");
    const resultName = document.getElementById("resultName");
    const resultMeta = document.getElementById("resultMeta");
    const download = document.getElementById("download");

    const selected = [];
    let outputUrl = null;
    let running = false;

    function formatBytes(bytes) {
      if (!bytes) return "0 B";
      const units = ["B", "KB", "MB", "GB"];
      const i = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
      return (bytes / 1024 ** i).toFixed(i ? 1 : 0) + " " + units[i];
    }

    function setProgress(value, title, message) {
      fill.style.width = value + "%";
      percent.textContent = value + "%";
      stage.textContent = title;
      detail.textContent = message || "";
    }

    function render() {
      count.textContent = String(selected.length);
      convert.disabled = selected.length === 0 || running;

      if (!selected.length) {
        imageList.innerHTML = '<div class="empty">No images selected.</div>';
        return;
      }

      imageList.innerHTML = "";
      selected.forEach((file, index) => {
        const row = document.createElement("div");
        row.className = "image-row";

        const number = document.createElement("span");
        number.className = "image-index";
        number.textContent = String(index + 1).padStart(2, "0");

        const image = document.createElement("img");
        image.src = URL.createObjectURL(file);
        image.alt = file.name;

        const info = document.createElement("div");
        info.className = "image-info";

        const name = document.createElement("b");
        name.textContent = file.name;

        const meta = document.createElement("small");
        meta.textContent = formatBytes(file.size);

        info.append(name, meta);

        const remove = document.createElement("button");
        remove.className = "remove";
        remove.type = "button";
        remove.textContent = "×";
        remove.setAttribute("aria-label", "Remove " + file.name);
        remove.addEventListener("click", () => {
          selected.splice(index, 1);
          render();
        });

        row.append(number, image, info, remove);
        imageList.appendChild(row);
      });
    }

    function addFiles(list) {
      for (const file of Array.from(list || [])) {
        if (!file.type.startsWith("image/")) continue;

        const duplicate = selected.findIndex(
          (item) => item.name.toLowerCase() === file.name.toLowerCase()
        );

        if (duplicate >= 0) {
          selected.splice(duplicate, 1);
        }

        selected.push(file);
      }

      render();
      topStatus.textContent = selected.length ? "READY" : "READY";
    }

    function readDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result));
        reader.onerror = () => reject(new Error("Could not read " + file.name));
        reader.readAsDataURL(file);
      });
    }

    function readImageSize(dataUrl) {
      return new Promise((resolve, reject) => {
        const image = new Image();
        image.onload = () => resolve({ width: image.naturalWidth, height: image.naturalHeight });
        image.onerror = () => reject(new Error("Could not decode the image."));
        image.src = dataUrl;
      });
    }

    choose.addEventListener("click", () => filesInput.click());

    dropzone.addEventListener("click", (event) => {
      if (!event.target.closest("button")) {
        filesInput.click();
      }
    });

    filesInput.addEventListener("change", () => {
      addFiles(filesInput.files);
      filesInput.value = "";
    });

    ["dragenter", "dragover"].forEach((name) => {
      dropzone.addEventListener(name, (event) => {
        event.preventDefault();
        event.stopPropagation();
        dropzone.classList.add("drag");
      });
    });

    ["dragleave", "drop"].forEach((name) => {
      dropzone.addEventListener(name, (event) => {
        event.preventDefault();
        event.stopPropagation();
        dropzone.classList.remove("drag");
      });
    });

    dropzone.addEventListener("drop", (event) => {
      addFiles(event.dataTransfer.files);
    });

    clear.addEventListener("click", () => {
      if (running) return;

      selected.length = 0;
      if (outputUrl) {
        URL.revokeObjectURL(outputUrl);
        outputUrl = null;
      }

      download.href = "#";
      download.classList.add("disabled");
      resultName.textContent = "No file yet";
      resultMeta.textContent = "—";
      topStatus.textContent = "READY";
      setProgress(0, "Waiting", "Select one or more images.");
      render();
    });

    convert.addEventListener("click", async () => {
      if (running || !selected.length) return;

      running = true;
      convert.disabled = true;
      topStatus.textContent = "CONVERTING";

      if (outputUrl) {
        URL.revokeObjectURL(outputUrl);
        outputUrl = null;
      }

      download.href = "#";
      download.classList.add("disabled");
      resultName.textContent = "Building presentation…";
      resultMeta.textContent = "Preparing " + selected.length + " slide" + (selected.length === 1 ? "" : "s") + ".";

      try {
        setProgress(10, "Preparing", "Creating PowerPoint…");

        const pptx = new PptxGenJS();
        pptx.layout = "LAYOUT_WIDE";
        pptx.author = "IS";
        pptx.subject = "Images to PowerPoint";
        pptx.title = "IS — Images to PowerPoint";
        pptx.company = "IS";
        pptx.lang = "en-US";
        pptx.theme = {
          headFontFace: "Arial",
          bodyFontFace: "Arial",
          lang: "en-US"
        };

        for (let i = 0; i < selected.length; i++) {
          const file = selected[i];
          setProgress(
            15 + Math.round((i / selected.length) * 70),
            "Converting",
            "Adding image " + (i + 1) + " of " + selected.length + "…"
          );

          const data = await readDataUrl(file);
          const size = await readImageSize(data);

          const slide = pptx.addSlide();
          slide.background = { color: "FFFFFF" };

          const slideWidth = 13.333333;
          const slideHeight = 7.5;
          const slideRatio = slideWidth / slideHeight;
          const imageRatio = size.width / size.height;

          let w;
          let h;
          let x;
          let y;

          if (imageRatio >= slideRatio) {
            w = slideWidth;
            h = w / imageRatio;
            x = 0;
            y = (slideHeight - h) / 2;
          } else {
            h = slideHeight;
            w = h * imageRatio;
            x = (slideWidth - w) / 2;
            y = 0;
          }

          slide.addImage({
            data,
            x,
            y,
            w,
            h
          });
        }

        setProgress(90, "Finishing", "Generating PPTX…");
        const blob = await pptx.write({ outputType: "blob" });

        outputUrl = URL.createObjectURL(blob);
        download.href = outputUrl;
        download.download = "IS_Images_to_PowerPoint.pptx";
        download.classList.remove("disabled");

        resultName.textContent = "IS_Images_to_PowerPoint.pptx";
        resultMeta.textContent =
          selected.length + (selected.length === 1 ? " slide" : " slides") +
          " · " + formatBytes(blob.size);

        setProgress(100, "Done", "PowerPoint ready.");
        topStatus.textContent = "READY";
      } catch (error) {
        console.error(error);
        topStatus.textContent = "ERROR";
        setProgress(0, "Failed", error?.message || "Could not create the PowerPoint.");
        resultName.textContent = "Conversion failed";
        resultMeta.textContent = error?.message || "Could not create the PowerPoint.";
      } finally {
        running = false;
        convert.disabled = selected.length === 0;
      }
    });

    render();
  </script>
</body>
</html>

<style>
:global(*){box-sizing:border-box}
:global(body){
  margin:0;min-height:100vh;background:#06090d;color:#edf2f7;
  font:14px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
}
:global(button),:global(input){font:inherit}
:global(a){text-decoration:none;color:inherit}
.app{width:min(820px,calc(100% - 28px));margin:0 auto;padding:18px 0 28px}
.topbar{height:48px;padding:0 12px;border:1px solid #1b2631;border-radius:9px;background:#0a0f14;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.08em}
.logo{width:27px;height:27px;border-radius:7px;background:#2c8cff;display:grid;place-items:center;font-size:9px;font-weight:900;color:#fff}
.status{display:flex;align-items:center;gap:7px;color:#718094;font-size:8px;font-weight:900;letter-spacing:.08em}
.status i{width:6px;height:6px;border-radius:50%;background:#42d992}
.intro{padding:48px 2px 22px}
.eyebrow{color:#4da4ff;font-size:8px;font-weight:900;letter-spacing:.16em}
.intro h1{font-size:38px;line-height:1;margin:10px 0 0;letter-spacing:-.055em}
.card{background:#0a0f14;border:1px solid #1b2631;border-radius:10px;padding:14px;margin-top:10px}
.row-head,.files-head,.progress-head,.result-row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.label{color:#718094;font-size:8px;font-weight:900;letter-spacing:.13em}
.count{min-width:23px;height:23px;padding:0 7px;border-radius:6px;display:grid;place-items:center;background:#0d1822;border:1px solid #203246;color:#5faaff;font-size:8px;font-weight:900}
.dropzone{min-height:175px;margin-top:9px;border:1px dashed #2d4053;border-radius:9px;background:#080d12;display:flex;align-items:center;justify-content:center;flex-direction:column;cursor:pointer}
.dropzone:hover,.dropzone.drag{border-color:#2c8cff;background:#0a1118}
.upload{width:36px;height:36px;border:1px solid #27405a;border-radius:8px;display:grid;place-items:center;color:#55a7ff;font-size:20px;margin-bottom:8px}
.dropzone strong{font-size:11px}.dropzone span{margin-top:3px;color:#687688;font-size:8px}
.files-head{margin:13px 1px 7px;color:#718094;font-size:8px;font-weight:900;letter-spacing:.11em}
.clear{border:0;background:transparent;color:#657487;font-size:8px;font-weight:900;letter-spacing:.08em;cursor:pointer}.clear:hover{color:#ff7884}
.image-list{display:grid;gap:5px}.empty{padding:12px;text-align:center;color:#596779;border:1px solid #17222d;border-radius:8px;font-size:9px}
.image-row{display:grid;grid-template-columns:27px 56px 1fr 25px;align-items:center;gap:9px;padding:6px;background:#080d12;border:1px solid #17222d;border-radius:8px}
.image-index{width:23px;height:23px;border-radius:5px;background:#0d1924;color:#58aaff;display:grid;place-items:center;font-size:7px;font-weight:900}
.image-row img{width:56px;height:38px;object-fit:cover;border-radius:5px}.image-info{min-width:0}
.image-info b{display:block;font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.image-info small{display:block;color:#627184;font-size:7px;margin-top:2px}
.remove{width:24px;height:24px;border:1px solid #263544;border-radius:6px;background:#0b1218;color:#738196;cursor:pointer}.remove:hover{color:#ff7884}
.convert{width:100%;margin-top:12px;height:40px}.progress-card{padding:13px 14px}
.progress-head{color:#768396;font-size:8px;font-weight:900;letter-spacing:.06em}.progress-head b{color:#edf2f7}
.track{height:6px;margin-top:8px;border-radius:99px;background:#111922;overflow:hidden}.fill{height:100%;width:0;border-radius:99px;background:#2c8cff;transition:width .2s}
.detail{margin-top:6px;color:#667486;font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.result{padding:13px 14px}.result .label{margin-bottom:8px}.result-row>div{min-width:0}
.result-row strong{display:block;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.result-row span{display:block;color:#627184;font-size:8px;margin-top:2px}
.button{border:1px solid #294056;border-radius:7px;background:#101923;color:#e4ebf2;padding:9px 12px;font-size:8px;font-weight:900;letter-spacing:.07em;cursor:pointer}
.button.primary{background:#2c8cff;border-color:#2c8cff;color:#fff}.button.primary:hover:not(:disabled){background:#2377dc}
.button:disabled,.button.disabled{opacity:.35;pointer-events:none}footer{padding:15px 2px 0;color:#4f5c6c;font-size:8px}
@media(max-width:560px){.app{width:min(100% - 18px,820px)}.intro h1{font-size:32px}.result-row{align-items:stretch;flex-direction:column}.result-row .button{width:100%}}
</style>