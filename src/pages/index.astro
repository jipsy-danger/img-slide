<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>IMG-SLIDE // Python PowerPoint Builder</title>
  <meta name="description" content="Run build_slide.py in the browser and download the generated PowerPoint." />
</head>

<body>
  <div class="noise"></div>

  <div class="wrap">
    <header class="top">
      <a class="brand" href="./">
        <span class="mark">IS</span>
        <span>IMG-SLIDE</span>
      </a>
      <nav class="nav">
        <a href="#builder">BUILDER</a>
        <a href="#process">PROCESS</a>
        <a href="#source">SOURCE</a>
        <a href="https://github.com/jipsy-danger/img-slide" target="_blank" rel="noreferrer">GITHUB ↗</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div>
          <div class="eyebrow">JIPSY-DANGER / PYTHON-IN-THE-BROWSER</div>
          <h1>IMAGE →<br /><span>POWERPOINT.</span></h1>
          <p>
            Drop the image assets used by <strong>build_slide.py</strong>, run the exact
            repository Python source directly in your browser, watch the build progress,
            and download the finished <strong>.pptx</strong>.
          </p>
          <div class="hero-meta">
            <span class="live-dot"></span>
            <span>PYTHON ENGINE</span>
            <span class="sep">/</span>
            <span>PYODIDE + WEBASSEMBLY</span>
            <span class="sep">/</span>
            <span>BROWSER-SIDE</span>
          </div>
        </div>

        <aside class="hud">
          <div class="hudhead">
            <span>ENGINE STATUS</span>
            <span class="online">READY</span>
          </div>
          <div class="status">
            <i class="dot"></i>
            <span id="engineStatus">WAITING FOR INPUT</span>
          </div>
          <div class="metric"><span>Repository</span><b>img-slide</b></div>
          <div class="metric"><span>Python source</span><b>build_slide.py</b></div>
          <div class="metric"><span>Framework</span><b>Astro</b></div>
          <div class="metric"><span>Runtime</span><b>Pyodide 0.29.5</b></div>
          <div class="metric"><span>Output</span><b>.pptx</b></div>
        </aside>
      </section>

      <section class="builder section" id="builder">
        <div class="section-top">
          <div>
            <div class="section-kicker">01 / INPUT</div>
            <h2>Upload image assets</h2>
            <p>
              Use one drop zone for the full image set. The current Python file references
              the filenames listed below, so the page checks them before starting the build.
            </p>
          </div>
          <div class="counter" id="assetCounter">0 / 12 READY</div>
        </div>

        <div class="drop-zone" id="dropZone">
          <input id="fileInput" type="file" accept="image/png,image/jpeg,image/webp" multiple hidden />
          <div class="drop-icon">↑</div>
          <div class="drop-title">DROP IMAGES HERE</div>
          <div class="drop-sub">or click to browse • PNG / JPG / WEBP</div>
          <button class="btn secondary" id="browseBtn" type="button">SELECT IMAGES</button>
        </div>

        <div class="asset-grid" id="assetGrid"></div>

        <div class="manifest">
          <div class="manifest-head">
            <span>REQUIRED ASSET MANIFEST</span>
            <span>EXACT FILENAMES USED BY build_slide.py</span>
          </div>
          <div class="manifest-list" id="manifestList"></div>
        </div>

        <div class="builder-actions">
          <button class="btn primary large" id="buildBtn" type="button" disabled>
            <span class="btn-led"></span>
            RUN build_slide.py
          </button>
          <button class="btn ghost" id="clearBtn" type="button">CLEAR</button>
        </div>
      </section>

      <section class="section" id="process">
        <div class="section-kicker">02 / EXECUTION</div>
        <div class="process-layout">
          <div class="progress-card">
            <div class="progress-head">
              <span>BUILD PIPELINE</span>
              <span id="percentLabel">0%</span>
            </div>

            <div class="progress-track">
              <div class="progress-fill" id="progressFill"></div>
            </div>

            <div class="stage-title" id="stageTitle">Waiting for images…</div>
            <div class="stage-detail" id="stageDetail">The Python runtime will start when you launch the build.</div>

            <div class="steps">
              <div class="pstep" data-step="input"><span>01</span><b>INPUT</b><em>Upload assets</em></div>
              <div class="pstep" data-step="runtime"><span>02</span><b>RUNTIME</b><em>Load Python + packages</em></div>
              <div class="pstep" data-step="execute"><span>03</span><b>EXECUTE</b><em>Run build_slide.py</em></div>
              <div class="pstep" data-step="output"><span>04</span><b>OUTPUT</b><em>Package .pptx</em></div>
            </div>
          </div>

          <div class="console-card">
            <div class="console-head">
              <span>PROCESS CONSOLE</span>
              <span id="consoleState">IDLE</span>
            </div>
            <pre id="console">[IMG-SLIDE] Builder initialized.
[IMG-SLIDE] Waiting for asset upload.</pre>
          </div>
        </div>
      </section>

      <section class="section output-section">
        <div class="section-kicker">03 / OUTPUT</div>
        <div class="output-card" id="outputCard">
          <div class="output-icon">PPT</div>
          <div>
            <div class="output-label">GENERATED PRESENTATION</div>
            <h2 id="outputName">No presentation generated yet</h2>
            <p id="outputMeta">Run the Python builder to create a downloadable PowerPoint.</p>
          </div>
          <a class="btn primary disabled" id="downloadBtn" href="#" download>DOWNLOAD .PPTX</a>
        </div>
      </section>

      <section class="section" id="source">
        <div class="section-kicker">04 / SOURCE</div>
        <div class="source-grid">
          <div class="code-card">
            <div class="codebar"><span>build_slide.py</span><span>REPOSITORY SOURCE</span></div>
            <pre>from pptx import Presentation
from pptx.util import Emu, Pt
from pptx.dml.color import RGBColor
from lxml import etree

# ...
# Innovation & Uniqueness
# 3D LiDAR → Adaptive 2.5D Conversion Engine
# ...

prs.save('/mnt/user-data/outputs/DarcARK_Innovation_Uniqueness.pptx')</pre>
          </div>

          <div class="info-card">
            <div class="info-row">
              <span>EXECUTION</span>
              <b>Browser-side Python</b>
            </div>
            <div class="info-row">
              <span>PYTHON VERSION</span>
              <b>CPython / WebAssembly</b>
            </div>
            <div class="info-row">
              <span>POWERPOINT</span>
              <b>python-pptx 1.0.2</b>
            </div>
            <div class="info-row">
              <span>ASSET TRANSPORT</span>
              <b>Local browser memory</b>
            </div>
            <div class="info-row">
              <span>SERVER UPLOAD</span>
              <b>Not required</b>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <span>IMG-SLIDE // JIPSY-DANGER</span>
      <span>ASTRO + PYODIDE + GITHUB PAGES • <span id="clock">--:--:--</span></span>
    </footer>
  </div>

  <script>
    const REQUIRED = [
      "logo.png", "p1g.png", "p2g.png", "cube.png", "center.png",
      "arrow.png", "grid.png", "th1.png", "th2.png", "ic1.png", "ic2.png", "ic3.png"
    ];

    const files = new Map();
    const fileInput = document.getElementById("fileInput");
    const browseBtn = document.getElementById("browseBtn");
    const dropZone = document.getElementById("dropZone");
    const assetGrid = document.getElementById("assetGrid");
    const manifestList = document.getElementById("manifestList");
    const assetCounter = document.getElementById("assetCounter");
    const buildBtn = document.getElementById("buildBtn");
    const clearBtn = document.getElementById("clearBtn");
    const engineStatus = document.getElementById("engineStatus");
    const progressFill = document.getElementById("progressFill");
    const percentLabel = document.getElementById("percentLabel");
    const stageTitle = document.getElementById("stageTitle");
    const stageDetail = document.getElementById("stageDetail");
    const consoleEl = document.getElementById("console");
    const consoleState = document.getElementById("consoleState");
    const downloadBtn = document.getElementById("downloadBtn");
    const outputName = document.getElementById("outputName");
    const outputMeta = document.getElementById("outputMeta");

    let worker = null;
    let objectUrl = null;
    let building = false;

    function logLine(message) {
      const stamp = new Date().toLocaleTimeString([], { hour12: false });
      consoleEl.textContent += "\\n[" + stamp + "] " + message;
      consoleEl.scrollTop = consoleEl.scrollHeight;
    }

    function normalize(name) {
      return String(name || "").toLowerCase();
    }

    function renderManifest() {
      manifestList.innerHTML = REQUIRED.map((name) => {
        const ok = files.has(normalize(name));
        return '<div class="manifest-item ' + (ok ? "ok" : "") + '">' +
          '<span class="manifest-dot"></span><span>' + name + '</span>' +
          '<b>' + (ok ? "READY" : "MISSING") + '</b></div>';
      }).join("");
    }

    function renderAssets() {
      assetGrid.innerHTML = "";

      if (!files.size) {
        assetGrid.innerHTML = '<div class="empty-assets">No image assets selected yet.</div>';
      } else {
        for (const [key, file] of files.entries()) {
          const card = document.createElement("div");
          card.className = "asset";
          const preview = document.createElement("img");
          preview.alt = file.name;
          preview.src = URL.createObjectURL(file);
          const meta = document.createElement("div");
          meta.className = "asset-meta";
          meta.innerHTML =
            '<b>' + file.name + '</b>' +
            '<span>' + Math.max(1, Math.round(file.size / 1024)) + ' KB</span>';
          const remove = document.createElement("button");
          remove.className = "asset-remove";
          remove.type = "button";
          remove.textContent = "×";
          remove.title = "Remove " + file.name;
          remove.addEventListener("click", () => {
            files.delete(key);
            renderAll();
          });
          card.appendChild(preview);
          card.appendChild(meta);
          card.appendChild(remove);
          assetGrid.appendChild(card);
        }
      }

      updateValidation();
    }

    function updateValidation() {
      const ready = REQUIRED.filter((name) => files.has(normalize(name))).length;
      assetCounter.textContent = ready + " / " + REQUIRED.length + " READY";
      buildBtn.disabled = building || ready !== REQUIRED.length;
      buildBtn.classList.toggle("ready", ready === REQUIRED.length && !building);

      if (!building) {
        engineStatus.textContent = ready === REQUIRED.length ? "READY TO BUILD" : "WAITING FOR INPUT";
      }
    }

    function renderAll() {
      renderManifest();
      renderAssets();
    }

    function addFiles(list) {
      for (const file of Array.from(list || [])) {
        if (!file.type.startsWith("image/")) continue;
        files.set(normalize(file.name), file);
      }
      renderAll();
    }

    browseBtn.addEventListener("click", () => fileInput.click());
    dropZone.addEventListener("click", (event) => {
      if (event.target.closest("button")) return;
      fileInput.click();
    });

    fileInput.addEventListener("change", () => {
      addFiles(fileInput.files);
      fileInput.value = "";
    });

    ["dragenter", "dragover"].forEach((eventName) => {
      dropZone.addEventListener(eventName, (event) => {
        event.preventDefault();
        dropZone.classList.add("drag");
      });
    });

    ["dragleave", "drop"].forEach((eventName) => {
      dropZone.addEventListener(eventName, (event) => {
        event.preventDefault();
        dropZone.classList.remove("drag");
      });
    });

    dropZone.addEventListener("drop", (event) => {
      addFiles(event.dataTransfer.files);
    });

    clearBtn.addEventListener("click", () => {
      if (building) return;
      files.clear();
      if (objectUrl) {
        URL.revokeObjectURL(objectUrl);
        objectUrl = null;
      }
      downloadBtn.classList.add("disabled");
      downloadBtn.href = "#";
      outputName.textContent = "No presentation generated yet";
      outputMeta.textContent = "Run the Python builder to create a downloadable PowerPoint.";
      progressFill.style.width = "0%";
      percentLabel.textContent = "0%";
      stageTitle.textContent = "Waiting for images…";
      stageDetail.textContent = "The Python runtime will start when you launch the build.";
      consoleState.textContent = "IDLE";
      consoleEl.textContent = "[IMG-SLIDE] Builder initialized.\\n[IMG-SLIDE] Waiting for asset upload.";
      renderAll();
    });

    function setProgress(percent, stage, detail) {
      progressFill.style.width = percent + "%";
      percentLabel.textContent = percent + "%";
      stageTitle.textContent = stage;
      stageDetail.textContent = detail || "";
    }

    function setStepState(activeStage, percent) {
      const steps = [...document.querySelectorAll(".pstep")];
      const groups = [
        { key: "input", min: 0, max: 9 },
        { key: "runtime", min: 10, max: 65 },
        { key: "execute", min: 66, max: 90 },
        { key: "output", min: 91, max: 100 }
      ];
      steps.forEach((step) => {
        const key = step.dataset.step;
        const group = groups.find((g) => g.key === key);
        step.classList.toggle("active", activeStage === key);
        step.classList.toggle("done", group && percent >= group.max);
      });
    }

    function stageKeyFromProgress(percent) {
      if (percent < 10) return "input";
      if (percent < 66) return "runtime";
      if (percent < 91) return "execute";
      return "output";
    }

    async function startBuild() {
      if (building) return;

      const missing = REQUIRED.filter((name) => !files.has(normalize(name)));
      if (missing.length) {
        logLine("ERROR: Missing assets: " + missing.join(", "));
        return;
      }

      building = true;
      updateValidation();
      buildBtn.classList.add("working");
      buildBtn.querySelector(".btn-led").style.animation = "pulse .8s infinite";
      consoleState.textContent = "RUNNING";
      engineStatus.textContent = "BUILDING…";
      logLine("Starting browser-side Python execution.");
      logLine("Loading the exact build_slide.py from main.");

      worker?.terminate();
      worker = new Worker("/img-slide/python-worker.js");

      worker.onmessage = (event) => {
        const data = event.data || {};

        if (data.type === "progress") {
          const percent = Number(data.percent || 0);
          setProgress(percent, data.stage, data.detail);
          setStepState(stageKeyFromProgress(percent), percent);
          if (data.stage) logLine(data.stage + (data.detail ? " — " + data.detail : ""));
          return;
        }

        if (data.type === "done") {
          building = false;
          updateValidation();
          buildBtn.classList.remove("working");
          consoleState.textContent = "COMPLETE";
          engineStatus.textContent = "PRESENTATION READY";
          setProgress(100, "Complete", "The PowerPoint is ready to download.");
          setStepState("output", 100);

          if (objectUrl) URL.revokeObjectURL(objectUrl);
          const blob = new Blob([data.buffer], { type: data.mime || "application/vnd.openxmlformats-officedocument.presentationml.presentation" });
          objectUrl = URL.createObjectURL(blob);

          downloadBtn.href = objectUrl;
          downloadBtn.download = data.name || "IMG-SLIDE.pptx";
          downloadBtn.classList.remove("disabled");

          outputName.textContent = data.name || "Generated presentation";
          outputMeta.textContent = "Generated in the browser • " + (blob.size / 1024 / 1024).toFixed(2) + " MB";
          logLine("SUCCESS: " + (data.name || "PowerPoint") + " created.");
          logLine("SUCCESS: Download is ready.");
          worker.terminate();
          worker = null;
          return;
        }

        if (data.type === "error") {
          building = false;
          buildBtn.classList.remove("working");
          updateValidation();
          consoleState.textContent = "ERROR";
          engineStatus.textContent = "BUILD FAILED";
          setStepState("execute", 0);
          stageTitle.textContent = "Build failed";
          stageDetail.textContent = data.message || "Unknown Python error.";
          logLine("ERROR: " + (data.message || "Unknown Python error."));
          if (data.detail) logLine(data.detail);
          worker.terminate();
          worker = null;
        }
      };

      const transfer = [];
      const payload = [];

      for (const file of files.values()) {
        const buffer = await file.arrayBuffer();
        payload.push({ name: file.name, buffer });
        transfer.push(buffer);
      }

      worker.postMessage({ type: "build", files: payload }, transfer);
    }

    buildBtn.addEventListener("click", startBuild);

    renderAll();

    const clock = document.getElementById("clock");
    function tick() {
      clock.textContent = new Date().toLocaleTimeString([], { hour12: false });
    }
    tick();
    setInterval(tick, 1000);
  </script>
</body>
</html>

<style>
:global(*) { box-sizing:border-box }
:global(html) { scroll-behavior:smooth }
:global(body) {
  margin:0;
  background:
    radial-gradient(850px 500px at 84% -10%, rgba(23,105,165,.23), transparent 65%),
    radial-gradient(720px 420px at -10% 25%, rgba(73,53,163,.12), transparent 65%),
    linear-gradient(180deg,#06090f 0%,#05070c 100%);
  color:#e7eef7;
  font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  min-height:100vh;
}
:global(body):before {
  content:""; position:fixed; inset:0; pointer-events:none; opacity:.13;
  background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);
  background-size:32px 32px;
  mask-image:linear-gradient(to bottom,black,transparent 88%);
}
:global(a) { color:inherit; text-decoration:none }
:global(button),:global(input) { font:inherit }
.wrap { max-width:1260px; margin:auto; padding:24px }
.noise {
  position:fixed; inset:0; pointer-events:none; opacity:.035; z-index:20;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 220 220' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.24'/%3E%3C/svg%3E");
}
.top {
  height:58px; border:1px solid #1b2a3a; background:#09111bf2; backdrop-filter:blur(16px);
  display:flex; align-items:center; justify-content:space-between; padding:0 18px;
  border-radius:15px; position:sticky; top:14px; z-index:10; box-shadow:0 18px 70px rgba(0,0,0,.45);
}
.brand { display:flex; align-items:center; gap:11px; font-weight:850; letter-spacing:.1em }
.mark {
  width:31px; height:31px; border-radius:8px; display:grid; place-items:center;
  background:linear-gradient(135deg,#7c3aed,#22d3ee); color:#fff; font-size:12px; font-weight:900;
}
.nav { display:flex; gap:6px }
.nav a { padding:8px 11px; border-radius:9px; color:#8493a7; font-size:11px; font-weight:800; letter-spacing:.08em }
.nav a:hover { color:#fff; background:#ffffff09 }
.hero {
  padding:82px 8px 34px; display:grid; grid-template-columns:1fr 370px; gap:34px; align-items:end;
}
.eyebrow,.section-kicker {
  color:#45c9ff; font-size:10px; font-weight:900; letter-spacing:.22em;
}
.hero h1 { margin:13px 0 18px; font-size:clamp(45px,7.1vw,86px); line-height:.9; letter-spacing:-.07em }
.hero h1 span { color:#8f79ff }
.hero p { max-width:720px; margin:0; color:#8795a7; font-size:16px }
.hero p strong { color:#dce7f5 }
.hero-meta {
  display:flex; flex-wrap:wrap; gap:10px; margin-top:25px; color:#708095; font-size:10px; font-weight:800; letter-spacing:.11em;
}
.live-dot,.dot { display:inline-block; width:7px; height:7px; border-radius:50%; background:#41e59d; box-shadow:0 0 13px rgba(65,229,157,.75) }
.sep { color:#314155 }
.hud,.builder,.progress-card,.console-card,.output-card,.code-card,.info-card {
  border:1px solid #1a2a3a; background:linear-gradient(145deg,#0b141f,#091019); box-shadow:0 24px 70px rgba(0,0,0,.36);
}
.hud { border-radius:17px; padding:19px }
.hudhead,.console-head,.codebar {
  display:flex; justify-content:space-between; align-items:center; gap:10px;
  color:#748398; font-size:10px; font-weight:900; letter-spacing:.12em;
}
.online { color:#41e59d }
.status { display:flex; align-items:center; gap:9px; margin:25px 0 18px; font-weight:850 }
.metric { display:grid; grid-template-columns:1fr auto; gap:9px; padding:10px 0; border-top:1px solid #172637 }
.metric span { color:#748398 }
.metric b { color:#d7e4f2; text-align:right; font-size:12px }
.section { margin-top:57px }
.section h2 { margin:6px 0 8px; font-size:25px; letter-spacing:-.04em }
.section p { margin:0; color:#7f8da0 }
.builder { padding:23px; border-radius:18px }
.section-top { display:flex; justify-content:space-between; gap:20px; align-items:end; margin-bottom:20px }
.counter { border:1px solid #274057; background:#0c1925; color:#a7d9f4; padding:7px 10px; border-radius:999px; font-size:10px; font-weight:900; letter-spacing:.1em; white-space:nowrap }
.drop-zone {
  min-height:208px; border:1px dashed #2e4e68; border-radius:17px; background:
    radial-gradient(500px 200px at 50% 10%,rgba(45,183,255,.11),transparent 70%),#08111a;
  display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; cursor:pointer;
  transition:.18s ease; padding:25px;
}
.drop-zone:hover,.drop-zone.drag { border-color:#4bd2ff; transform:translateY(-1px); background-color:#0a1520 }
.drop-icon {
  width:48px; height:48px; border:1px solid #31526c; border-radius:12px; display:grid; place-items:center;
  color:#4bd2ff; font-size:20px; margin-bottom:12px; background:#0d1c29;
}
.drop-title { font-size:13px; font-weight:900; letter-spacing:.15em }
.drop-sub { color:#728197; font-size:11px; margin:5px 0 14px }
.asset-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:10px; margin-top:13px }
.asset,.empty-assets {
  min-width:0; border:1px solid #1a2a38; border-radius:12px; background:#09111a; padding:9px; position:relative;
}
.asset { overflow:hidden }
.asset img { width:100%; aspect-ratio:1.55; object-fit:cover; display:block; border-radius:8px; background:#05090d }
.asset-meta { display:flex; flex-direction:column; gap:2px; margin-top:7px }
.asset-meta b { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:10px }
.asset-meta span { color:#6f7e92; font-size:9px }
.asset-remove {
  position:absolute; right:7px; top:7px; width:22px; height:22px; border-radius:7px; border:1px solid #33465a;
  background:#08111ae8; color:#b9c6d4; cursor:pointer;
}
.asset-remove:hover { color:#fff; border-color:#ff6b79 }
.empty-assets { grid-column:1/-1; color:#6f7e92; text-align:center; padding:17px }
.manifest { margin-top:17px; border:1px solid #172637; border-radius:13px; overflow:hidden }
.manifest-head,.builder-actions {
  display:flex; justify-content:space-between; align-items:center; gap:14px;
}
.manifest-head { padding:10px 12px; background:#081019; color:#7e8c9f; font-size:9px; font-weight:900; letter-spacing:.12em }
.manifest-list { display:grid; grid-template-columns:repeat(3,1fr) }
.manifest-item {
  display:grid; grid-template-columns:8px 1fr auto; gap:8px; align-items:center; padding:9px 11px;
  border-top:1px solid #132332; color:#98a7ba; font-size:10px;
}
.manifest-item b { color:#5c6b7e; font-size:8px; letter-spacing:.08em }
